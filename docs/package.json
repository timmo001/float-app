{
  "name": "float-app-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler versions upload",
    "preview": "astro preview",
    "gen:cli": "bun scripts/generate-cli-reference.ts && bunx prettier --write src/content/docs/cli/commands.md",
    "pregen:cli": "bun install --cwd .. --frozen-lockfile",
    "predev": "bun run gen:cli",
    "prebuild": "bun run gen:cli"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.2",
    "astro": "^7.3.3",
    "starlight-links-validator": "^0.26.0",
    "starlight-llms-txt": "^0.12.0"
  },
  "devDependencies": {
    "prettier": "^3.9.8",
    "wrangler": "^4.136.1"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp"
  ]
}
