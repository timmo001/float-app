{
  "name": "float-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "float-app": "./dist/float-app"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --compile --outfile dist/float-app",
    "test": "bun test",
    "lint": "oxlint .",
    "prelint": "bun install --cwd docs --frozen-lockfile && bun run --cwd docs astro sync",
    "completions": "bun run .scripts/generate-completions.ts",
    "completions:check": "bun run .scripts/generate-completions.ts --check",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \".scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \".scripts/**/*.ts\"",
    "prepare": "effect-tsgo patch --force=false"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.6",
    "effect": "4.0.6"
  },
  "devDependencies": {
    "@effect/tsgo": "0.59.0",
    "@oxlint/plugins": "1.89.0",
    "@timmo001/oxlint-rules": "0.6.3",
    "@types/bun": "^1.4.2",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "^3.9.8",
    "typescript": "~7.0.2"
  }
}
